{
  "name": "mindpath",
  "author": "MindPath",
  "type": "module",
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev:app": "run-p dev:spotlight dev:next",
    "dev": "run-s dev:app",
    "build:next": "next build",
    "build-local": "run-s db:migrate build:next",
    "build": "run-s build:next",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "commit": "commit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- node scripts/db-migrate.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@arcjet/next": "^1.11.0",
    "@clerk/localizations": "^4.15.8",
    "@clerk/nextjs": "^7.8.3",
    "@clerk/ui": "^1.31.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/nextjs": "^10.72.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.35.0",
    "motion": "^12.43.0",
    "next": "^16.3.3",
    "next-intl": "^4.14.1",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "reflect-metadata": "^0.2.2",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1",
    "tsyringe": "^4.10.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/prompt-cli": "^21.2.2",
    "@commitlint/types": "^21.0.1",
    "@lingual/i18n-check": "^0.9.5",
    "@next/bundle-analyzer": "^16.3.3",
    "@spotlightjs/spotlight": "^4.11.8",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.33.0",
    "lefthook": "^2.1.12",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^0.25.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "ultracite": "^7.10.7"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
