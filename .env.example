# MindPath environment variables
# Copy this file to `.env.local` and fill in the values.
# See README.md for setup details.

# =============================================================================
# Required — app will not start without these
# =============================================================================

# Clerk authentication
# Create an application at https://clerk.com and copy keys from the dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Supabase Postgres — create a project at https://supabase.com/dashboard
# Project Settings → Database → Connection string
# App runtime: Transaction pooler (port 6543). `npm run db:migrate` auto-switches 6543 → 5432 (session pooler) for DDL.
# If you see "password authentication failed", reset the database password in Supabase and paste the new URI here.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# =============================================================================
# Recommended for local development
# =============================================================================

# Public app URL (used for metadata, redirects, and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Console log level: error | info | debug | warning | trace | fatal
NEXT_PUBLIC_LOGGING_LEVEL=info

# =============================================================================
# Optional — security (Arcjet)
# =============================================================================

# Bot protection and WAF. Get a key at https://launch.arcjet.com/Q6eLbRE
# Must start with `ajkey_`. Leave unset to disable Arcjet in middleware.
# ARCJET_KEY=ajkey_your_arcjet_key

# =============================================================================
# Optional — error monitoring (Sentry)
# =============================================================================

# In development, Sentry uses Spotlight automatically (http://localhost:8969).
# Set NEXT_PUBLIC_SENTRY_DISABLED=true to skip Sentry entirely (e.g. CI).
# NEXT_PUBLIC_SENTRY_DISABLED=true

# Production Sentry project (also used for source map uploads during build)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORGANIZATION=
# SENTRY_PROJECT=

# Set in your hosting provider for source map uploads (not needed locally)
# SENTRY_AUTH_TOKEN=

# =============================================================================
# Optional — log management (Better Stack)
# =============================================================================

# When both are set, logs are sent to Better Stack in addition to the console.
# NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=
# NEXT_PUBLIC_BETTER_STACK_INGESTING_HOST=

# =============================================================================
# Optional — analytics (PostHog)
# =============================================================================

# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# =============================================================================
# Optional — development and build tooling
# =============================================================================

# Disable forwarding browser logs to the terminal (Next.js dev)
# BROWSER_TO_TERMINAL_DISABLED=true

# Enable bundle analyzer (`npm run build-stats`)
# ANALYZE=true

# NODE_ENV is set automatically by Next.js (development | production | test)
